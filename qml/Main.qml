import QtQuick 2.15
import QtQuick.Controls 2.15
import QtQuick.Layouts 1.15
ApplicationWindow{visible:true;width:1100;height:720;title:"LemonadeAI";property bool setup:appConfig.apiKey.length===0
StackView{anchors.fill:parent;initialItem:setup?settings:chat}
Component{id:settings;Page{background:Rectangle{color:"#101218"};ColumnLayout{anchors.centerIn:parent;width:650;spacing:14;Label{text:"🍋 LemonadeAI";font.pixelSize:34;color:"white";Layout.alignment:Qt.AlignHCenter};Label{text:"Configure sua IA";color:"#aab0bd";Layout.alignment:Qt.AlignHCenter};TextField{id:key;Layout.fillWidth:true;echoMode:TextInput.Password;placeholderText:"Gemini API Key"};TextField{id:name;Layout.fillWidth:true;text:appConfig.aiName;placeholderText:"Nome da IA"};TextArea{id:inst;Layout.fillWidth:true;Layout.preferredHeight:180;text:appConfig.instructions;wrapMode:TextArea.Wrap};Button{text:"Salvar e continuar";enabled:key.text.length>0;Layout.alignment:Qt.AlignRight;onClicked:{appConfig.apiKey=key.text;appConfig.aiName=name.text;appConfig.instructions=inst.text;appConfig.save();StackView.view.replace(chat)}}}}}
Component{id:chat;Page{background:Rectangle{color:"#0d0f13"};header:ToolBar{RowLayout{anchors.fill:parent;Label{text:"🍋 LemonadeAI";color:"white";font.bold:true;font.pixelSize:20;Layout.leftMargin:12};Item{Layout.fillWidth:true};Label{text:bridge.connected?"● Studio conectado":"● Studio desconectado";color:bridge.connected?"#69db7c":"#ff7777"};Button{text:"Conectar Studio";onClicked:bridge.ping()}}}ColumnLayout{anchors.fill:parent;anchors.margins:16;ListView{id:list;Layout.fillWidth:true;Layout.fillHeight:true;model:ListModel{id:m};delegate:Rectangle{width:list.width;height:t.implicitHeight+20;color:model.role==="user"?"#181d26":"#11151b";Text{id:t;anchors.fill:parent;anchors.margins:10;color:"white";text:"<b>"+model.role+":</b> "+model.text;wrapMode:Text.Wrap}}};RowLayout{Layout.fillWidth:true;TextArea{id:prompt;Layout.fillWidth:true;Layout.preferredHeight:70;placeholderText:"Descreva o jogo, mapa, NPC ou sistema que quer criar..."};Button{text:"Enviar";enabled:prompt.text.length>0&&!agent.busy;onClicked:{var p=prompt.text;prompt.clear();agent.ask(p)}}}}Connections{target:agent;function onMessage(role,text){m.append({role:role,text:text});list.positionViewAtEnd()}}Connections{target:bridge;function onResult(x){m.append({role:"studio",text:x})}function onError(x){m.append({role:"studio erro",text:x})}}}}
